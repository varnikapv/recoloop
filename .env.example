# RecoLoop classifier — copy to .env and fill in.
# The API key is read from the environment only; it is never written to a file
# the repo tracks, and never appears in any generated artefact.
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional. Overrides the model id in src/lib/classify/config.ts.
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional. PROVIDER selects the transport when --provider is not passed.
# PROVIDER=gemini
# GEMINI_MODEL=gemini-3.1-flash-lite   # the default; 3.6-flash caps at 20 req/day on the free tier
# GEMINI_MIN_INTERVAL_MS=6500
